<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DuonDevKit.Dapper</PackageId>
    <Version>0.2.0</Version>
    <Description>Dapper integration for DuonDevKit — runs raw SQL through the same DbContext connection/transaction as EF Core (so it stays atomic inside a UnitOfWork transaction), wrapped in DuonDevKit.Core's Result pattern.</Description>
    <PackageTags>dapper;entity-framework-core;result;sql;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- Unconditional: see DuonDevKit.EntityFrameworkCore.csproj for why the EF Core family doesn't
         need a per-TFM version split. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuonDevKit.Core\DuonDevKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
