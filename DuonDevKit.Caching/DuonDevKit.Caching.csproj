<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DuonDevKit.Caching</PackageId>
    <Version>0.1.0</Version>
    <Description>Cache abstraction for DuonDevKit — HybridCache-backed (memory-only, or memory+Redis when configured), wrapped in DuonDevKit.Core's Result pattern.</Description>
    <PackageTags>caching;redis;hybridcache;result;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="9.10.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.19" />
    <!-- CI's clean restore resolves a >= 10.0.11 floor for this package that a local restore
         (warmer NuGet cache) doesn't surface — pin at least that high to avoid NU1605. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuonDevKit.Core\DuonDevKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>