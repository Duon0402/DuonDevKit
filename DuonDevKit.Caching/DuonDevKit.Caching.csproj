<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DuonDevKit.Caching</PackageId>
    <Version>0.1.1</Version>
    <Description>Cache abstraction for DuonDevKit — HybridCache-backed (memory-only, or memory+Redis when configured), wrapped in DuonDevKit.Core's Result pattern.</Description>
    <PackageTags>caching;redis;hybridcache;result;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="9.10.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.19" />
    <!-- Microsoft.Extensions.Caching.Hybrid 9.10.0 pulls in Microsoft.Extensions.Logging.Abstractions
         9.0.19, which itself needs Microsoft.Extensions.DependencyInjection.Abstractions >= 9.0.19 — a
         clean restore fails NU1605 below that floor even though a warm NuGet cache can mask it locally.
         Pinned at the exact floor (9.0.19) rather than a higher round number so this stays as close as
         possible to the 9.0.18 the rest of the package family (Core/EntityFrameworkCore/Dapper) uses. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuonDevKit.Core\DuonDevKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project deterministically drive HybridCache's stampede-join leader/joiner roles
         directly (bypassing HybridCacheService's public surface) to regression-test race conditions. -->
    <InternalsVisibleTo Include="DuonDevKit.Caching.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>