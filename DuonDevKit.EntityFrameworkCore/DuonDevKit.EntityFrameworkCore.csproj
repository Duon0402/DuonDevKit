<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DuonDevKit.EntityFrameworkCore</PackageId>
    <Version>0.7.1</Version>
    <Description>EF Core Repository/UnitOfWork built on DuonDevKit.Core's Result pattern, plus automatic audit fields (ICanCreate/ICanUpdate/ISoftDelete), soft-delete query filtering, and a Specification pattern for reusable query shapes.</Description>
    <PackageTags>entity-framework-core;repository;unit-of-work;result;audit;soft-delete;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unconditional: the EF Core 9.x packages ship a single net8.0 asset used by both our net8.0
         and net9.0 builds — no need for a per-TFM version split (unlike Microsoft.AspNetCore.*
         packages, which are single-TFM per major version; see DuonDevKit.Jwt.csproj). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuonDevKit.Core\DuonDevKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
